---
import { COMPLIANCE, TAGLINE, BOOKING_URL, SECONDARY_NAV, SERVICES_MENU, CONTACT } from '../site.config';
const year = 2026;
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <div class="footer-brand">
        <img src="/brand/psg-logo-128.webp" alt="Prosperity Services Group logo" width="128" height="123" />
        <p class="tagline">{TAGLINE}</p>
      </div>
      <nav class="footer-links">
        {SERVICES_MENU.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
        {SECONDARY_NAV.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))}
      </nav>
      <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-gold">Schedule Consultation</a>
    </div>

    <div class="footer-sister-links">
      <p class="sister-agency">
        For Medicare and health insurance, visit our sister agency
        <a href="https://priceservicesgroup.com" target="_blank" rel="noopener noreferrer">Price Services Group</a>
        or learn more at <a href="https://learnmedicare.org" target="_blank" rel="noopener noreferrer">LearnMedicare.org</a>.
      </p>
    </div>

    <div class="compliance">
      <p class="contact-line">
        <a href={CONTACT.phoneHref}>{CONTACT.phone}</a> (toll-free) &bull;
        <a href={CONTACT.phoneLocalHref}>{CONTACT.phoneLocal}</a> (local) &bull;
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      </p>
      <p class="address-line">{CONTACT.address.line1}, {CONTACT.address.city}, {CONTACT.address.state} {CONTACT.address.zip}</p>
      <p>{COMPLIANCE.npn} &bull; {COMPLIANCE.agencyNpn}</p>
      <p>Licensed in: {COMPLIANCE.states.join(', ')}</p>
      <p class="footer-disclaimer">{COMPLIANCE.footerDisclaimer}</p>
      <p class="annuity-disclaimer">{COMPLIANCE.annuityDisclaimer}</p>
      <p class="copyright">&copy; {year} Prosperity Services Group LLC. {TAGLINE}. <a href="/privacy">Privacy Policy</a> &bull; <a href="/terms">Terms of Use</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-dark);
    color: #e7dcf4;
    padding: 3.5rem 0 2rem;
    margin-top: 3rem;
  }
  .footer-inner { display: flex; flex-direction: column; gap: 1.5rem; }
  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255,255,255,0.12);
  }
  .footer-brand img { height: 34px; margin-bottom: 0.4rem; }
  .tagline { font-family: var(--font-heading); font-style: italic; color: var(--color-teal); margin: 0; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 1rem 1.5rem; max-width: 640px; }
  .footer-links a { color: #d8c8ea; text-decoration: none; font-size: 0.9rem; }
  .footer-links a:hover { color: var(--color-teal); }
  .footer-sister-links { border-bottom: 1px solid rgba(255,255,255,0.12); padding-bottom: 1.25rem; }
  .compliance p {
    font-size: 0.78rem;
    line-height: 1.6;
    color: #b6a4cb;
    max-width: 900px;
    margin: 0 0 0.5rem;
  }
  .contact-line { color: #d8c8ea !important; font-weight: 600; font-size: 0.85rem !important; }
  .contact-line a { color: inherit; text-decoration: underline; }
  .address-line { font-size: 0.85rem !important; }
  .sister-agency { font-size: 0.85rem !important; margin: 0 !important; color: #b6a4cb; }
  .sister-agency a { color: var(--color-teal); text-decoration: underline; }
  .footer-disclaimer { font-weight: 600; }
  .annuity-disclaimer { font-style: italic; }
  .copyright { color: #9e8bb6; }
  .copyright a { color: #b6a4cb; text-decoration: underline; }
  .copyright a:hover { color: var(--color-teal); }
</style>
