---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOKING_URL, COMPLIANCE } from '../site.config';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Fixed Indexed Annuities Explained',
    description: 'A plain-English overview of fixed indexed annuity crediting methods, contract terms, costs, and optional income features.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is a fixed indexed annuity?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A fixed indexed annuity is an insurance contract. Interest credits are calculated using a formula tied in part to an external index; the contract is not a direct investment in that index.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I lose money in a fixed indexed annuity?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A contract's index-credit floor may limit negative index-linked interest for a period, but fees, withdrawals, rider charges, and surrender terms can affect contract value. Check the specific policy.',
        },
      },
      {
        '@type': 'Question',
        name: 'How is interest credited on an FIA?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Each contract period, the insurance company calculates interest credits based on the performance of the linked index, subject to caps, participation rates, or spreads outlined in your contract.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can a fixed indexed annuity provide lifetime income?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Some contracts offer optional lifetime income riders, often for a fee. Payouts, eligibility, conditions, and guarantees depend on the rider and insurer.',
        },
      },
      {
        '@type': 'Question',
        name: 'Who might consider a fixed indexed annuity?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Some people consider FIAs for a portion of long-term savings. Whether one fits depends on liquidity needs, fees, contract limits, alternatives, and personal circumstances.',
        },
      },
      {
        '@type': 'Question',
        name: 'What is the difference between a cap rate and a participation rate?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A cap rate is the maximum interest rate your contract can credit in a given period, even if the index gains more. A participation rate determines what percentage of the index\'s gain is used to calculate your credited interest. Both, along with spreads, are ways carriers manage how much index gain is passed through to you, and they vary by contract and carrier.',
        },
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://prosperityservicesgroup.com/' },
      { '@type': 'ListItem', position: 2, name: 'Annuities', item: 'https://prosperityservicesgroup.com/annuities' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.page-hero .subhead', '.key-statement'],
    },
  },
];
---
<BaseLayout
  title="Fixed Indexed Annuities, Explained | Prosperity Group"
  description="Learn how fixed indexed annuities work in plain English — principal protection, growth potential, and lifetime income options for retirement."
  path="/annuities"
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow eyebrow-gold">Annuities</p>
      <h1>Fixed Indexed Annuities, Explained</h1>
      <p class="subhead">
        A fixed indexed annuity (FIA) is a contract with an insurance company designed to help
        protect your savings while giving them a chance to grow — without exposing your principal
        directly to stock market losses.
      </p>
    </div>
  </section>

  <section>
    <div class="container narrow">
      <h2>What is a fixed indexed annuity?</h2>
      <p>
        A fixed indexed annuity is an insurance contract, not an investment in the stock market
        itself. When you put money into an FIA, the insurance company credits interest to your
        contract based in part on the performance of a market index — but your principal is not
        directly invested in that index. This structure is what allows an FIA to offer growth
        potential tied to market movement while still protecting your original deposit from
        market losses.
      </p>

      <h2>How does it work?</h2>
      <p>
        Each year (or contract period), the insurance company calculates interest credits based on
        the performance of the index the contract is tied to, subject to the terms, caps,
        participation rates, or spreads outlined in your contract. If the index goes up, you may
        receive a positive interest credit. A contract's index-credit floor may limit negative index-linked interest for a period, but fees, withdrawals, rider charges, and surrender terms can affect contract value. Check the specific policy.
      </p>

      <h2>Key benefits</h2>
      <div class="grid grid-3">
        <div class="card card-gold">
          <h3>Principal Protection</h3>
          <p class="key-statement">An index-credit floor may limit index-linked losses, but fees, withdrawals, rider charges, and surrender provisions can reduce contract value. Terms vary by policy.</p>
        </div>
        <div class="card card-gold">
          <h3>Growth Potential</h3>
          <p>Interest credits are linked to the performance of a market index, offering the opportunity for growth beyond typical fixed-rate products.</p>
        </div>
        <div class="card card-gold">
          <h3>Lifetime Income Options</h3>
          <p>Some contracts offer optional lifetime income riders, often for a fee. Payouts, eligibility, conditions, and guarantees depend on the rider and insurer. See how this works on our <a href="/income">Lifetime Income Planning</a> page.</p>
        </div>
      </div>

      <h2>Understanding the floor and the cap</h2>
      <p>
        A contract may specify a floor for index-linked interest credits. A zero floor may mean no negative index-linked credit for a period; it does not prevent fees, withdrawals, rider charges, or surrender terms from reducing value. The cap is the maximum interest rate
        the contract can credit in a given period, even if the index gains more than that. Some
        contracts use a participation rate instead of, or alongside, a cap — crediting a set
        percentage of the index's gain — or a spread, which subtracts a set percentage from the
        index's gain before crediting interest. Caps, participation rates, and spreads can all
        change at renewal, within limits set by the contract, so it's worth understanding how your
        specific contract works rather than assuming the initial rate lasts forever.
      </p>

      <h2>Who might consider an FIA?</h2>
      <p>
        Fixed indexed annuities are generally designed for people who want to protect a portion of
        their retirement savings from market risk while still participating in some growth
        potential — often as part of a broader
        <a href="/safe-money">"safe money" strategy</a> alongside other retirement
        assets. They tend to fit best for money you don't need immediate, unrestricted access to,
        given surrender charge periods, and for people who value predictability over the
        possibility of higher but less certain market returns. Whether an FIA fits your situation
        depends on your goals, timeline, and full financial picture. Want a deeper walkthrough?
        Request our <a href="/guide">free PSG Annuity Guide</a>.
      </p>

      <h2>Common myths about fixed indexed annuities</h2>
      <ul>
        <li>
          <strong>"An FIA is the same as investing in the stock market."</strong> Not true — your
          the contract is not a direct investment in the index; an index-linked formula calculates interest credits subject to policy terms.
        </li>
        <li>
          <strong>"I can lose my principal if the market crashes."</strong> An index decline may mean no index-linked interest credit for that period, but fees, rider charges, withdrawals, and surrender terms can still reduce contract value.
        </li>
        <li>
          <strong>"All annuities are the same."</strong> Not true — fixed, fixed indexed, and
          variable annuities work very differently, and even within FIAs, crediting methods, caps,
          participation rates, and riders vary significantly by carrier and contract.
        </li>
        <li>
          <strong>"Once I buy an annuity, my money is locked up forever."</strong> Not entirely
          true — most contracts allow penalty-free withdrawals up to a set percentage each year,
          even during the surrender charge period, though full access to the full account value
          may be limited for a number of years.
        </li>
      </ul>

      <h2>How to evaluate a fixed indexed annuity</h2>
      <p>
        If you're comparing FIA contracts, a few questions are worth asking about each one: What is
        the surrender charge schedule, and how much can you withdraw penalty-free each year? What
        crediting methods are available, and what are the current caps, participation rates, or
        spreads? Is there an optional income rider, and what does it cost? What is the financial
        strength rating of the issuing insurance company? And critically — does the contract match
        your timeline, since money you may need access to in the next few years generally isn't a
        good fit for a product with a multi-year surrender schedule. A licensed insurance agent can
        walk through these details across multiple carriers so you're comparing contracts on an
        apples-to-apples basis rather than relying on a single company's pitch.
      </p>

      <h2>FIAs compared to other options</h2>
      <p>
        A fixed indexed annuity is not a bank deposit or CD. Crediting methods, fees, access limits, and guarantees differ; compare the specific contract terms. Compared to owning stocks
        or mutual funds directly, an FIA trades away some upside potential for downside
        protection — you may not receive the full return of a market index, and fees, withdrawals, rider charges, and other contract provisions may affect value. Compared to a variable annuity, which
        invests your premium directly into market-based subaccounts, an FIA keeps your principal
        out of direct market exposure entirely. None of these options is universally "better" —
        the right fit depends on how much of your savings you want protected versus growth-focused,
        and over what time horizon you're investing.
      </p>

      <div class="disclaimer">
        {COMPLIANCE.annuityDisclaimer}
      </div>
    </div>
  </section>

  <section class="section-alt cta-band">
    <div class="container cta-inner">
      <h2>Want to see if an FIA fits your plan?</h2>
      <p>Schedule a free, no-pressure consultation with a licensed independent agent.</p>
      <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-gold">Schedule a Consultation</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: var(--color-lavender); padding: 4rem 0; }
  :root[data-theme="dark"] .page-hero { background: var(--color-bg-alt); }
  .subhead { color: var(--color-text-muted); font-size: 1.1rem; max-width: 700px; margin-bottom: 0; }
  .narrow { max-width: 820px; }
  .cta-band { text-align: center; }
  .cta-inner p { color: var(--color-text-muted); margin-bottom: 1.5rem; }
  .disclaimer { margin-top: 2rem; }
</style>
