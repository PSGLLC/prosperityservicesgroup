---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOKING_URL, COMPLIANCE } from '../site.config';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Lifetime Income Planning',
    description: 'Learn how retirement income planning may coordinate Social Security, savings, and optional annuity income riders, including their costs and conditions.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is an income rider?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'An income rider is an optional feature on some fixed indexed annuity contracts, often for a fee. Payment amounts, eligibility, conditions, and guarantees depend on the rider and contract.',
        },
      },
      {
        '@type': 'Question',
        name: 'Why does guaranteed income matter in retirement?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Social Security and, for some, a pension provide a foundation of guaranteed income, but for many people that foundation is not enough to cover all expenses. Some guaranteed income sources may help cover expenses, but no source alone ensures your savings will last; consider your full financial picture.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can an income rider run out?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Some riders may provide payments under specified conditions even if contract value is depleted. Payment duration and conditions depend on the rider and issuing insurer\'s claims-paying ability.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do fixed indexed annuities support an income plan?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Fixed indexed annuities use contract-specific index-credit formulas and may offer optional income riders. Fees, withdrawals, surrender terms, and payout conditions can affect value and access.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do I build an income plan?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The right income strategy depends on your full financial picture, including your other savings, Social Security timing, expenses, and goals. A licensed agent can help you map out where guaranteed income fits.',
        },
      },
      {
        '@type': 'Question',
        name: 'What is a fixed indexed annuity?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A fixed indexed annuity is an insurance contract that calculates interest using a formula tied in part to an external index. Charges, withdrawals, rider costs, and contract terms can affect value. Guarantees depend on the policy and issuing insurer\'s claims-paying ability.',
        },
      },
      {
        '@type': 'Question',
        name: 'How does FIA income work in retirement?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Some FIAs offer optional income riders, often for a fee. Payment calculations, eligibility, age factors, and withdrawal conditions vary by contract.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is my FIA income guaranteed?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'An FIA income rider may guarantee payments under specified contract conditions. Guarantees depend on the rider and issuing insurer\'s claims-paying ability, not a bank or government guarantee.',
        },
      },
      {
        '@type': 'Question',
        name: 'What happens to my FIA if the market drops?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'A contract may set a floor for index-linked interest credits. That does not prevent charges, withdrawals, rider costs, or surrender provisions from reducing value; check the specific policy.',
        },
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://prosperityservicesgroup.com/' },
      { '@type': 'ListItem', position: 2, name: 'Income Planning', item: 'https://prosperityservicesgroup.com/income' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.page-hero .subhead', '.key-statement'],
    },
  },
];
---
<BaseLayout
  title="Lifetime Income Planning | Prosperity Services Group"
  description="Explore retirement income options and the conditions that apply to optional annuity income riders."
  path="/income"
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow eyebrow-gold">Income Planning</p>
      <h1>Turning Savings Into Lifetime Income</h1>
      <p class="subhead">
        One of the biggest shifts in retirement is moving from saving money to spending it.
        Lifetime income planning considers how savings, benefits, and other resources may support your spending needs over time.
      </p>
    </div>
  </section>

  <section>
    <div class="container narrow">
      <h2>Why predictable income can matter</h2>
      <p>
        Social Security and, for some, a pension provide a foundation of guaranteed income in
        retirement. But for many people, that foundation isn't enough to cover all of their
        expenses. Planning can compare potential income sources, spending needs, and the possibility that savings may not last as long as expected.
      </p>

      <h2>What is an income rider?</h2>
      <div class="callout-gold">
        <p class="key-statement" style="margin-bottom:0;">
          An income rider is an optional feature on some fixed indexed annuity contracts, often for an additional fee. Under the rider's specified eligibility, withdrawal, and other conditions, it may provide payments for life, sometimes even if the contract value is depleted. Payment calculations and access to contract value vary by rider. Guarantees depend on the issuing insurer's claims-paying ability and the contract.
        </p>
      </div>

      <h2>How FIAs can support an income plan</h2>
      <p>
        Some fixed indexed annuities use contract-specific formulas to calculate interest credits and may offer an optional income rider. Fees, withdrawals, rider costs, surrender terms, and payout conditions can affect contract value and access. Review the terms before deciding whether a product fits your plan. Learn more on our <a href="/annuities">Fixed Indexed Annuities</a> page, or see the broader approach on our <a href="/safe-money">Safe Money</a> page.
      </p>

      <h2>Building your income plan</h2>
      <p>
        The right income strategy depends on your full financial picture — your other savings,
        Social Security timing, expenses, and goals. A licensed agent can help you map out where
        guaranteed income fits alongside your other retirement assets. Prefer to start with a
        written overview? Request our <a href="/guide">free PSG Annuity Guide</a>, or
        <a href="/contact">get in touch</a> with any questions.
      </p>

      <div class="disclaimer">
        {COMPLIANCE.annuityDisclaimer}
      </div>
    </div>
  </section>

  <section class="section-alt cta-band">
    <div class="container cta-inner">
      <h2>Ready to map out your income plan?</h2>
      <p>Schedule a free, no-pressure consultation with a licensed independent insurance agent.</p>
      <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-gold">Schedule a Consultation</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: var(--color-lavender); padding: 4rem 0; }
  :root[data-theme="dark"] .page-hero { background: var(--color-bg-alt); }
  .subhead { color: var(--color-text-muted); font-size: 1.1rem; max-width: 700px; margin-bottom: 0; }
  .narrow { max-width: 820px; }
  .cta-band { text-align: center; }
  .cta-inner p { color: var(--color-text-muted); margin-bottom: 1.5rem; }
  .disclaimer { margin-top: 2rem; }
</style>
