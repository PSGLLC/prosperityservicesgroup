---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOKING_URL, COMPLIANCE, CONTACT } from '../site.config';

const services = [
  { href: '/annuities', title: 'Fixed Indexed Annuities', desc: 'Explore how fixed indexed annuities credit interest and how contract terms, charges, and limits affect value.' },
  { href: '/life-insurance', title: 'Life Insurance', desc: 'Term and permanent coverage, final expense planning, and legacy protection for every stage of life.' },
  { href: '/long-term-care', title: 'Long-Term Care Planning', desc: 'Plan ahead for the cost of care Medicare doesn\'t cover, including hybrid life/LTC options.' },
  { href: '/retirement-income', title: 'Retirement Income Planning', desc: 'Turn savings into a reliable paycheck using Social Security timing, income riders, and a bucket strategy.' },
];

const trustPoints = [
  {
    title: 'Independent Agent',
    desc: 'As an independent agent, Kayla can discuss options from multiple insurers she represents; availability and recommendations depend on your needs and the contracts offered.',
  },
  {
    title: 'No-Fee Consultations',
    desc: 'There is no fee for a consultation and no obligation to buy. If you enroll in a product, an insurer may compensate the agency; terms and availability vary.',
  },
  {
    title: 'Education-First Approach',
    desc: 'Every conversation starts with your goals and full financial picture, not a product pitch — plain-English guidance you can actually use.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Prosperity Services Group',
    url: 'https://prosperityservicesgroup.com',
    description: 'Education about insurance options, contract terms, and retirement income planning.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FinancialService',
    name: 'Prosperity Services Group LLC',
    url: 'https://prosperityservicesgroup.com',
    description: 'Education about insurance options, contract terms, and retirement income planning.' ,
    telephone: CONTACT.phoneHref.replace('tel:', ''),
    email: CONTACT.email,
    areaServed: COMPLIANCE.states,
  },
  // No AggregateRating here: this repo has no Google Reviews integration or any
  // other real review-count source (checked functions/ and src/ for a reviews
  // API — none exists, unlike PSG-Main-Website's /api/reviews/google). Add
  // AggregateRating to this LocalBusiness block only once a real review source
  // is wired up — do not publish placeholder/fake ratingValue or reviewCount.
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: 'Prosperity Services Group LLC',
    url: 'https://prosperityservicesgroup.com',
    telephone: CONTACT.phoneHref.replace('tel:', ''),
    email: CONTACT.email,
    priceRange: 'Free Consultation',
    address: {
      '@type': 'PostalAddress',
      streetAddress: CONTACT.address.line1,
      addressLocality: CONTACT.address.city,
      addressRegion: CONTACT.address.state,
      postalCode: CONTACT.address.zip,
      addressCountry: 'US',
    },
    areaServed: COMPLIANCE.states,
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Retirement and Annuity Services',
      itemListElement: [
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Fixed Indexed Annuities' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Life Insurance' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Long-Term Care Planning' } },
        { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Retirement Income Planning' } },
      ],
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Kayla Price',
    jobTitle: 'Licensed Independent Insurance Agent',
    identifier: 'NPN 18530055',
    worksFor: {
      '@type': 'Organization',
      name: 'Prosperity Services Group LLC',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://prosperityservicesgroup.com/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    speakable: {
      '@type': 'SpeakableSpecification',
      cssSelector: ['.hero .subhead', '.key-statement'],
    },
  },
];
---
<BaseLayout
  title="Protect Your Retirement Savings | Prosperity Group"
  description="Learn about insurance options, their contract terms, and retirement income planning."
  path="/"
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow eyebrow-gold">Retirement &amp; Annuity Planning</p>
      <h1>Protect Your Retirement Income — Without Gambling Your Savings</h1>
      <p class="subhead">
        Fixed indexed annuities and safe money strategies can help protect what you've worked hard
        to build while still giving your savings room to grow. Get independent, plain-English
        guidance built around your goals — not a sales pitch.
      </p>
      <div class="hero-ctas">
        <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-gold">Schedule a Call</a>
        <a href="/annuities" class="btn btn-outline hero-outline">Learn About FIAs</a>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <p class="eyebrow">What We Do</p>
      <h2>Retirement protection, built around your whole picture</h2>
      <div class="grid grid-4">
        {services.map((s) => (
          <a href={s.href} class="card card-gold topic-card">
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <span class="learn-more">Learn more &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="container">
      <p class="eyebrow eyebrow-gold">Why Prosperity</p>
      <h2>Guidance you can actually trust</h2>
      <div class="grid grid-3">
        {trustPoints.map((t) => (
          <div class="card">
            <h3>{t.title}</h3>
            <p>{t.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container narrow protected-money">
      <p class="eyebrow eyebrow-gold">Is Your Money Protected?</p>
      <h2>Market risk vs. protected growth</h2>
      <p>
        Money invested directly in the market can grow faster in good years — but it can also lose
        value in a downturn, right when you may need to start drawing on it. A fixed indexed
        annuity uses a contract formula to calculate interest credits based in part on an external index. A negative index result may mean no index-linked credit for that period, while fees, withdrawals, rider costs, and surrender provisions may still affect contract value. Caps, participation rates, and spreads can limit credited interest. These features and tradeoffs are important to understand before considering an annuity.
      </p>
      <p>
        <a href="/annuities">See how fixed indexed annuities work in detail &rarr;</a>
      </p>
    </div>
  </section>

  <section class="cta-section">
    <div class="container cta-inner">
      <h2>Ready to protect your retirement?</h2>
      <p>Schedule a free, no-pressure consultation with a licensed independent agent.</p>
      <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-teal">Schedule a Call</a>
    </div>
  </section>

  <section class="section-alt">
    <div class="container meet-kayla">
      <img src="/img/headshot-520.webp" alt="Kayla, licensed independent insurance agent" class="headshot" width="520" height="520" />
      <div class="card kayla-card">
        <p class="eyebrow">Meet Kayla</p>
        <h2>Your guide to safe, steady retirement planning</h2>
        <p>
          Kayla is a licensed independent insurance agent (NPN 18530055) who helps people
          understand how fixed indexed annuities and safe money strategies fit into their
          retirement plan — in plain English, without pressure or a sales pitch.
        </p>
        <p class="key-statement">
          Because she isn't tied to a single insurance company, her focus stays on your goals —
          reviewing contract features and exploring income options.
        </p>
        <p>
          Want a written overview first? Request our <a href="/guide">free PSG Annuity Guide</a>,
          or <a href="/about">learn more about Kayla</a> and
          <a href="/contact">get in touch</a> with any questions.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(135deg, var(--color-dark) 0%, #2b1147 100%);
    color: #fff;
    padding: 6rem 0;
  }
  .hero-inner { max-width: 700px; }
  .hero h1 { color: #fff; font-size: clamp(2rem, 4vw, 3.2rem); }
  .subhead { font-size: 1.15rem; color: #e2d4f0; margin-bottom: 1.75rem; }
  .hero-ctas { display: flex; gap: 1rem; flex-wrap: wrap; }
  .hero-outline { border-color: #fff; color: #fff; }
  .hero-outline:hover { background: rgba(255,255,255,0.1); }

  .grid-4 { grid-template-columns: repeat(4, 1fr); }
  @media (max-width: 1100px) { .grid-4 { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .grid-4 { grid-template-columns: 1fr; } }

  .topic-card { text-decoration: none; display: block; transition: transform 0.15s ease; }
  .topic-card:hover { transform: translateY(-4px); }
  .topic-card h3 { font-size: 1.1rem; margin-bottom: 0.4rem; }
  .topic-card p { color: var(--color-text-muted); font-size: 0.9rem; margin: 0 0 0.75rem; }
  .learn-more { color: var(--color-purple); font-weight: 700; font-size: 0.85rem; }
  :root[data-theme="dark"] .learn-more { color: var(--color-teal); }

  .protected-money { max-width: 780px; }

  .meet-kayla {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .headshot {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .kayla-card p:last-child { margin-bottom: 0; }
  @media (max-width: 800px) {
    .meet-kayla { grid-template-columns: 1fr; }
    .headshot { max-width: 260px; margin: 0 auto; }
  }

  .cta-section {
    background: #60347f;
    color: #fff;
    text-align: center;
  }
  .cta-inner h2 { color: #fff; }
  .cta-inner p { color: #f0e6f8; margin-bottom: 1.5rem; }
</style>
