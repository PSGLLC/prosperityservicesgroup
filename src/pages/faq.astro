---
import BaseLayout from '../layouts/BaseLayout.astro';

const faqs = [
  {
    q: 'What is a fixed indexed annuity?',
    a: "A fixed indexed annuity is an insurance contract that may credit interest using a formula tied in part to an external index. Your premium is not directly invested in that index, but fees, withdrawals, rider costs, and surrender terms can still reduce contract value.",
  },
  {
    q: 'How is a fixed indexed annuity different from a variable annuity?',
    a: "A variable annuity generally invests in market-based subaccounts, so value can fluctuate with those investments. A fixed indexed annuity uses a contract formula to calculate interest credits; an index decline may mean no index-linked credit for a period, but charges, withdrawals, rider costs, and surrender terms may affect contract value.",
  },
  {
    q: 'Is my money safe with a fixed indexed annuity?',
    a: "A fixed indexed annuity is an insurance contract, not a bank deposit. Contract features may limit index-linked interest losses, but fees, withdrawals, rider costs, and surrender terms can reduce value. Any guarantees depend on the policy and the issuing insurer's claims-paying ability.",
  },
  {
    q: 'What is a surrender period?',
    a: 'A surrender period is a set number of years during which withdrawing more than a certain amount from your annuity may trigger a surrender charge. Most contracts allow penalty-free withdrawals up to a set percentage each year even during this period.',
  },
  {
    q: 'Can I lose money in a fixed indexed annuity?',
    a: "An index decline may mean no index-linked interest credit for that period, depending on the contract. This does not prevent fees, withdrawals, rider costs, or surrender terms from reducing contract value. Review the specific policy.",
  },
  {
    q: 'What does "safe money planning" mean?',
    a: "Safe money planning is an informal phrase for allocating part of a financial plan to options with different risk, access, and return characteristics. No strategy is risk-free; contract protections and guarantees depend on the policy and insurer.",
  },
  {
    q: 'How does retirement income planning work?',
    a: "Retirement income planning compares potential income sources such as Social Security, pensions, savings, and annuity payments with expected expenses. It can help evaluate tradeoffs, but does not guarantee income will cover every expense or last throughout retirement.",
  },
  {
    q: 'When should I start planning for retirement income?',
    a: 'Most people benefit from starting retirement income planning 5 to 10 years before their target retirement date, giving enough time to structure guaranteed income sources and adjust strategy as retirement approaches.',
  },
  {
    q: 'What is the difference between a pension and an annuity?',
    a: "A pension is an employer-funded retirement benefit, typically based on years of service and salary. An annuity is a contract purchased from an insurance company that may provide payments under selected contract terms; payment options, guarantees, and costs vary.",
  },
  {
    q: 'Can I use an annuity alongside Social Security?',
    a: "An annuity may complement Social Security. Payment options, amounts, timing, fees, and guarantees depend on the selected contract and insurer.",
  },
  {
    q: 'How do I know if an annuity is right for me?',
    a: 'It depends on your full financial picture — your other assets, income needs, risk tolerance, and time horizon. A licensed agent can review your situation and help you decide whether an annuity fits alongside your other retirement savings.',
  },
  {
    q: 'What happens to my annuity when I pass away?',
    a: "Beneficiary and death-benefit provisions vary by contract and payout option. Review the policy to understand what, if anything, may be payable after the owner's death.",
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'Retirement Planning FAQ',
    description: 'Answers to common questions about annuities, fixed indexed annuities, safe money planning, and retirement income strategies.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout
  title="Retirement & Annuity FAQ | Prosperity Services Group"
  description="Answers to common questions about annuities, fixed indexed annuities, safe money planning, and retirement income strategies."
  path="/faq"
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow eyebrow-gold">FAQ</p>
      <h1>Retirement Planning FAQ</h1>
      <p class="subhead">Common questions about annuities, safe money strategies, and retirement income.</p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="faq-list">
        {faqs.map((f) => (
          <div class="faq-item card">
            <h2>{f.q}</h2>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: var(--color-lavender); padding: 4rem 0; }
  :root[data-theme="dark"] .page-hero { background: var(--color-bg-alt); }
  .subhead { color: var(--color-text-muted); font-size: 1.1rem; max-width: 640px; margin-bottom: 0; }

  .faq-list { display: flex; flex-direction: column; gap: 1.25rem; max-width: 780px; margin: 0 auto; }
  .faq-item h2 { font-size: 1.15rem; margin-bottom: 0.5rem; }
  .faq-item p { color: var(--color-text-muted); margin-bottom: 0; }
</style>
