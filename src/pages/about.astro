---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BOOKING_URL, COMPLIANCE, CONTACT, TAGLINE } from '../site.config';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Kayla Price',
    jobTitle: 'Licensed Independent Insurance Agent',
    identifier: 'NPN 18530055',
    email: CONTACT.email,
    worksFor: {
      '@type': 'Organization',
      name: 'Prosperity Services Group LLC',
      url: 'https://prosperityservicesgroup.com',
    },
    knowsAbout: [
      'Fixed Indexed Annuities',
      'Life Insurance',
      'Long-Term Care Planning',
      'Retirement Income Planning',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About Prosperity Services Group',
    description: 'Meet Kayla Price and learn about Prosperity Services Group\'s mission to help people protect and grow their retirement savings.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://prosperityservicesgroup.com/' },
      { '@type': 'ListItem', position: 2, name: 'About', item: 'https://prosperityservicesgroup.com/about' },
    ],
  },
];
---
<BaseLayout
  title="About Kayla Price | Prosperity Services Group, LLC"
  description="Meet Kayla Price, a licensed independent insurance agent helping people protect retirement savings through annuities, life insurance, and income planning."
  path="/about"
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow eyebrow-gold">About Us</p>
      <h1>Retirement Planning, Where You Matter</h1>
      <p class="subhead">
        Prosperity Services Group was built on a simple idea: retirement planning should be
        plain-English, pressure-free, and centered on you — not a product or a sales quota.
      </p>
    </div>
  </section>

  <section>
    <div class="container meet-kayla">
      <img src="/img/headshot.png" alt="Kayla Price, licensed independent insurance agent" class="headshot" width="1024" height="1024" />
      <div class="card kayla-card">
        <p class="eyebrow">Meet Kayla Price</p>
        <h2>Your guide to safe, steady retirement planning</h2>
        <p>
          Kayla Price is a licensed independent insurance agent ({COMPLIANCE.npn}) who founded
          Prosperity Services Group to help people approaching or already in retirement make sense
          of their options for protecting savings and creating income. She works with clients on
          fixed indexed annuities, life insurance, long-term care planning, and retirement income
          strategies — always starting with education, not a pitch.
        </p>
        <p class="key-statement">
          Because Kayla is independent and not tied to a single insurance company, she can compare
          products across carriers and focus purely on what fits your goals, your timeline, and
          your comfort with risk.
        </p>
        <p>
          Kayla also leads Price Services Group, the Medicare and health insurance side of the
          business — but that work is kept entirely separate from Prosperity Services Group.
          <strong>Prosperity Services Group is not affiliated with or endorsed by Medicare or any
          government agency</strong>, and nothing on this site should be confused with Medicare
          plan guidance.
        </p>
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="container narrow">
      <p class="eyebrow eyebrow-gold">Our Mission</p>
      <h2>Why "{TAGLINE}" isn't just a tagline</h2>
      <p>
        Too many people feel like a number when they talk to a financial company — rushed through
        a script, sold a product before their goals are even understood. Prosperity Services
        Group exists to do the opposite. Every conversation starts with your situation: what
        you've saved, what you're worried about, and what "enough" looks like for you. From there,
        we walk through the options in plain English — no jargon, no pressure to decide on the
        spot.
      </p>
      <p>
        Whether the right fit ends up being a fixed indexed annuity, a life insurance policy, a
        long-term care plan, or simply a clearer picture of your retirement income, the goal is
        the same: you leave the conversation understanding your choices and confident in whichever
        one you make.
      </p>

      <h2>Licensed States</h2>
      <p>
        Kayla Price is a licensed independent insurance agent in the following states:
      </p>
      <ul class="states-list">
        {COMPLIANCE.states.map((s) => <li>{s}</li>)}
      </ul>

      <div class="disclaimer">
        {COMPLIANCE.annuityDisclaimer}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-inner">
      <h2>Ready to talk about your retirement?</h2>
      <p>Schedule a free, no-pressure consultation with a licensed independent agent.</p>
      <a href={BOOKING_URL} target="_blank" rel="noopener noreferrer" class="btn btn-gold">Schedule a Call</a>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero { background: var(--color-lavender); padding: 4rem 0; }
  :root[data-theme="dark"] .page-hero { background: var(--color-bg-alt); }
  .subhead { color: var(--color-text-muted); font-size: 1.1rem; max-width: 700px; margin-bottom: 0; }
  .narrow { max-width: 820px; }

  .meet-kayla {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .headshot { width: 100%; border-radius: var(--radius); box-shadow: var(--shadow); }
  .kayla-card p:last-child { margin-bottom: 0; }
  @media (max-width: 800px) {
    .meet-kayla { grid-template-columns: 1fr; }
    .headshot { max-width: 260px; margin: 0 auto; }
  }

  .states-list {
    display: grid;
    grid-template-columns: repeat(5, auto);
    gap: 0.5rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    font-weight: 700;
    color: var(--color-purple);
  }
  :root[data-theme="dark"] .states-list { color: var(--color-teal); }
  @media (max-width: 600px) {
    .states-list { grid-template-columns: repeat(2, auto); }
  }

  .cta-band { text-align: center; background: var(--color-purple); color: #fff; }
  .cta-band h2 { color: #fff; }
  .cta-inner p { color: #f0e6f8; margin-bottom: 1.5rem; }
</style>
