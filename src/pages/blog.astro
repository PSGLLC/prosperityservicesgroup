---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BLOG_POSTS } from '../data/blog-posts';

const posts = [...BLOG_POSTS].sort((a, b) => (a.publishDate < b.publishDate ? 1 : -1));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Prosperity Services Group Blog',
  description: 'Retirement income and annuity articles from Prosperity Services Group.',
  url: 'https://prosperityservicesgroup.com/blog',
};
---
<BaseLayout
  title="Retirement & Annuity Blog | Prosperity Services Group"
  description="Plain-English articles on fixed indexed annuities, retirement income planning, long-term care, and safe money strategies from Prosperity Services Group."
  path="/blog"
  jsonLd={jsonLd}
>
  <section class="blog-hero">
    <div class="container">
      <p class="eyebrow eyebrow-gold">Retirement Blog</p>
      <h1>Plain-English Retirement &amp; Annuity Articles</h1>
      <p class="blog-hero-sub">
        Practical, no-pressure articles on fixed indexed annuities, retirement income planning,
        long-term care, and safe money strategies.
      </p>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="post-list">
        {posts.map((p) => (
          <a href={`/blog/${p.slug}`} class="card post-card">
            <p class="post-date">{new Date(p.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
            <h2>{p.title}</h2>
            <p class="post-desc">{p.description}</p>
            <span class="learn-more">Read more &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-alt blog-newsletter-section">
    <div class="container blog-newsletter-inner">
      <div>
        <h2>Get Retirement Tips by Email</h2>
        <p>
          Want to know when new articles go live? Price Services Group sends occasional
          Medicare and retirement tips straight to your inbox — sign up on the main site.
        </p>
      </div>
      <a href="https://priceservicesgroup.com/blog/" target="_blank" rel="noopener" class="btn btn-primary">
        Sign Up for Tips &rarr;
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .blog-hero { padding: 3.5rem 0 2.5rem; text-align: center; }
  .blog-hero-sub { max-width: 58ch; margin: 1rem auto 0; font-size: 1.05rem; line-height: 1.7; }

  .post-list { display: grid; gap: 1.5rem; grid-template-columns: repeat(2, 1fr); max-width: 900px; margin: 0 auto; }
  @media (max-width: 700px) { .post-list { grid-template-columns: 1fr; } }
  .post-card { text-decoration: none; display: block; transition: transform 0.15s ease; }
  .post-card:hover { transform: translateY(-4px); }
  .post-date { color: var(--color-text-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.4rem; }
  .post-card h2 { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .post-desc { color: var(--color-text-muted); font-size: 0.95rem; margin-bottom: 0.75rem; }
  .learn-more { color: var(--color-purple); font-weight: 700; font-size: 0.85rem; }
  :root[data-theme="dark"] .learn-more { color: var(--color-teal); }

  .blog-newsletter-section { padding: 2.5rem 0 4rem; }
  .blog-newsletter-inner {
    display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap;
  }
  .blog-newsletter-inner h2 { margin: 0 0 .4rem; font-size: 1.3rem; }
  .blog-newsletter-inner p { margin: 0; color: var(--color-text-muted); max-width: 46ch; }
</style>
